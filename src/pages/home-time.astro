---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import SchedulePicker from '../components/SchedulePicker.astro';
import Faq from '../components/Faq.astro';

const questions = [
  ['Is home time guaranteed or targeted?', "There's a large difference, and recruiters will answer honestly if you ask directly."],
  ['What happens when a load runs long?', 'Do you get the day back, or is it gone?'],
  ['How far do I live from your lanes?', 'The single biggest predictor of whether advertised home time holds.'],
  ["What's the average for drivers on my fleet ... not company-wide?", 'Fleet averages differ enormously inside one carrier.'],
  ['Can I speak to a driver currently on that fleet?', 'A carrier confident in its answer will say yes.'],
];

const faqs = [
  {
    q: 'What does home time mean in trucking?',
    a: 'Home time is how often a driver returns to their home address, and how long they stay. It is usually expressed as a pattern ... home daily, home weekends, 7 on / 7 off ... or as a frequency, such as home every 10 to 14 days. It is the single factor most often cited by drivers who leave a carrier.'
  },
  {
    q: 'What does 7 on 7 off mean for truck drivers?',
    a: 'Seven consecutive days working, followed by seven consecutive days at home. It is one of the most predictable schedules in trucking and is typically offered on dedicated or regional fleets. Because the schedule is fixed, drivers can plan family commitments months ahead, which is rare in over-the-road work.'
  },
  {
    q: 'What is the difference between OTR, regional, and local driving?',
    a: 'Over-the-road (OTR) drivers run long distances nationally and are typically out two to three weeks at a time. Regional drivers cover a defined multi-state area and are usually home weekends. Local drivers work within a set radius and are home daily, often with more physical loading and unloading involved.'
  },
  {
    q: 'Do trucking companies actually honor their advertised home time?',
    a: 'It varies significantly by carrier and by fleet within the same carrier. Advertised home time reflects the target, not a guarantee, and it depends on freight lanes, dispatch discipline, and where a driver lives relative to the carrier terminals. Drivers living far from a carrier lane are the most likely to see home time slip.'
  },
  {
    q: 'Does more home time mean less pay?',
    a: 'Often, but not always. Home daily and dedicated positions typically pay less per year than long OTR because they run fewer miles. However, some dedicated accounts pay hourly or by the day and can be competitive, and drivers who stay longer at a carrier because the schedule works often out-earn those who change jobs repeatedly for slightly higher cents per mile.'
  },
  {
    q: 'How does home time affect driver retention?',
    a: 'Home time is consistently among the top reasons drivers leave a carrier, frequently ranking above pay in industry retention surveys. A driver whose schedule fits their family situation is substantially more likely to stay, which is why carriers increasingly compete on schedule instead of cents per mile alone.'
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  title="Home Time Explained - What Each Trucking Schedule Actually Means"
  description="Home daily, home weekends, 7 on 7 off, 14 on 7 off. What each trucking home time schedule means in practice, and what to ask a recruiter before you sign."
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-4xl font-bold">Home time, explained</h1>
    <p class="mt-4 text-lg text-slate">
      Carriers describe home time in shorthand. The shorthand is not always honest ...
      not because recruiters lie, but because the schedule depends on freight lanes,
      dispatch, and where you live. Here's how to read it.
    </p>

    <h2 class="mt-12 text-2xl font-bold">The schedules</h2>
    <p class="mt-2 text-slate">Pick one to see what a typical four weeks looks like.</p>
    <SchedulePicker />

    <h2 class="mt-12 text-2xl font-bold">Questions to ask before you sign</h2>
    <p class="mt-2 text-slate">Tick them off while you talk to the recruiter.</p>
    <ul class="mt-5 space-y-3">
      {questions.map(([q, why]) => (
        <li>
          <label class="flex cursor-pointer items-start gap-4 rounded-lg border border-navy/10 bg-white p-4 has-[:checked]:border-gold-ink has-[:checked]:bg-gold/10">
            <input type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-[#91620A]" />
            <Icon name="question" class="hidden h-8 w-8 shrink-0 text-navy sm:block" />
            <span class="text-slate"><strong class="block text-navy">{q}</strong>{why}</span>
          </label>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 text-2xl font-bold">Common questions</h2>
    <Faq faqs={faqs} />
  </article>

  <LeadForm />
</Layout>
