---
// Pick a schedule, see a typical four weeks. Works without JavaScript (all panels show);
// with JavaScript it becomes tabs, and /home-time/#seven-seven opens that tab.
import Icon from './Icon.astro';

type Day = 'out' | 'home' | 'split';
const rep = (d: Day, n: number): Day[] => Array(n).fill(d);
const week = (a: Day[]) => a;

const schedules: {
  id: string; name: string; icon: string; days: Day[]; homeLine: string; body: string;
}[] = [
  {
    id: 'home-daily', name: 'Home daily', icon: 'home-daily',
    days: [0, 1, 2, 3].flatMap(() => week([...rep('split', 5), ...rep('home', 2)])),
    homeLine: 'Home every night',
    body: 'Local and dedicated work inside a set radius. You sleep at home every night. Trade-offs: usually fewer miles, often earlier start times, and more touch freight ... you may be loading and unloading, not dropping and hooking.',
  },
  {
    id: 'home-weekends', name: 'Home weekends', icon: 'home-weekends',
    days: [0, 1, 2, 3].flatMap(() => week([...rep('out', 5), ...rep('home', 2)])),
    homeLine: 'About 8 days home in 4 weeks',
    body: 'Regional running inside a defined multi-state footprint. Out Monday, back Friday or Saturday is the pattern. The question to ask: most weekends, or every weekend? And what time Friday ... because home at 11pm Friday is not the same as home at noon.',
  },
  {
    id: 'seven-seven', name: '7 on / 7 off', icon: 'seven-seven',
    days: [...rep('out', 7), ...rep('home', 7), ...rep('out', 7), ...rep('home', 7)],
    homeLine: '14 days home in 4 weeks',
    body: "A week out, a week home. The most predictable schedule in trucking and the hardest to find. Because it's fixed, you can plan a birthday or a doctor's appointment months out ... which no other OTR schedule lets you do.",
  },
  {
    id: 'fourteen-seven', name: '14 on / 7 off', icon: 'fourteen-seven',
    days: [...rep('out', 14), ...rep('home', 7), ...rep('out', 7)],
    homeLine: 'About 7 days home in 4 weeks',
    body: 'Two weeks out, one week home. More miles than 7/7, still predictable. Common on national fleets that want OTR mileage with a schedule drivers can live with.',
  },
  {
    id: 'long-otr', name: 'Long OTR', icon: 'long-otr',
    days: [...rep('out', 21), ...rep('home', 4), ...rep('out', 3)],
    homeLine: 'About 4 days home in 4 weeks',
    body: 'Three weeks or more between home time. Highest miles and typically the highest annual pay. Works for some drivers and quietly destroys others. Be honest with yourself about which you are.',
  },
];
const dayNames = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const cellClass: Record<Day, string> = {
  out: 'bg-navy',
  home: 'bg-gold',
  split: 'bg-[linear-gradient(135deg,var(--color-navy)_50%,var(--color-gold)_50%)]',
};
const cellLabel: Record<Day, string> = { out: 'out on the road', home: 'home', split: 'working, home at night' };
---
<div class="mt-6" data-schedule-picker>
  <div role="tablist" aria-label="Schedules" class="hidden flex-wrap gap-2" data-tabs>
    {schedules.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${s.id}`}
        aria-controls={`panel-${s.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-id={s.id}
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-navy/15 bg-white px-4 text-sm font-semibold text-navy transition-colors hover:border-navy aria-selected:border-navy aria-selected:bg-navy aria-selected:text-cream"
      >
        <Icon name={s.icon} class="h-5 w-5" />
        {s.name}
      </button>
    ))}
  </div>

  {schedules.map((s) => (
    <section
      id={s.id}
      role="tabpanel"
      aria-labelledby={`tab-${s.id}`}
      data-panel={s.id}
      class="mt-6 scroll-mt-24 rounded-lg border border-navy/10 bg-white p-6 sm:p-8"
    >
      <div class="flex items-start gap-4">
        <Icon name={s.icon} class="h-12 w-12 shrink-0 text-navy" />
        <div>
          <h3 class="text-xl font-semibold text-gold-ink">{s.name}</h3>
          <p class="mt-1 text-sm font-semibold text-navy">{s.homeLine}</p>
        </div>
      </div>

      <div class="mt-6" aria-hidden="true">
        <div class="grid grid-cols-7 gap-1.5 text-center text-xs font-semibold text-slate">
          {dayNames.map((d) => <span>{d}</span>)}
        </div>
        <div class="mt-1.5 grid grid-cols-7 gap-1.5">
          {s.days.map((d) => (
            <span class={`h-7 rounded-sm sm:h-8 ${cellClass[d]}`} title={cellLabel[d]}></span>
          ))}
        </div>
      </div>
      <p class="sr-only">A typical four weeks: {s.homeLine.toLowerCase()}.</p>

      <p class="mt-5 text-slate">{s.body}</p>
    </section>
  ))}

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate" aria-hidden="true">
    <span class="inline-flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-navy"></span>On the road</span>
    <span class="inline-flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-gold"></span>Home</span>
    <span class="inline-flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-[linear-gradient(135deg,var(--color-navy)_50%,var(--color-gold)_50%)]"></span>Working, home at night</span>
    <span>A typical four weeks. Fleets vary; ask what yours actually runs.</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-schedule-picker]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const list = root.querySelector<HTMLElement>('[data-tabs]');
    if (!tabs.length || !list) return;
    list.classList.remove('hidden');
    list.classList.add('flex');
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.id === id;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
    };
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (tabs.some((t) => t.dataset.id === id)) { select(id); return true; }
      return false;
    };
    if (!fromHash()) select(tabs[0].dataset.id!);
    window.addEventListener('hashchange', fromHash);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        select(t.dataset.id!);
        history.replaceState(null, '', `#${t.dataset.id}`);
      });
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
        e.preventDefault();
        const n = tabs[(i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(n.dataset.id!, true);
      });
    });
  });
</script>
