---
// Tap-to-open questions. The FAQPage schema stays on the page that passes `faqs`.
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
<div class="mt-6 divide-y divide-navy/10 rounded-lg border border-navy/10 bg-white">
  {faqs.map((f) => (
    <details class="group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-semibold text-navy hover:text-teal-ink [&::-webkit-details-marker]:hidden">
        <span>{f.q}</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </summary>
      <p class="px-5 pb-5 text-slate">{f.a}</p>
    </details>
  ))}
</div>
