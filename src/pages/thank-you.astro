---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thanks — HomeTimeJobs" description="We received your information.">
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-4xl font-bold">Got it.</h1>
    <p class="mt-4 text-lg text-slate">
      A real person will reach out — usually within one business day.
      We'll ask a few more questions about your situation before we send anything to a carrier.
    </p>
    <a href="/home-time" class="mt-8 inline-block font-semibold text-teal hover:underline">
      While you wait — what each schedule actually means &rarr;
    </a>
  </section>
</Layout>
