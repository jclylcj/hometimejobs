---
// Thin-line icon in the HTJ logo's language. Stroke follows the text colour;
// the small gold squares use --icon-accent (set brighter on navy in global.css).
import { icons } from '../data/icons';
interface Props { name: string; class?: string; label?: string }
const { name, class: cls = 'h-10 w-10', label } = Astro.props;
const body = icons[name] ?? '';
---
<svg
  viewBox="0 0 32 32"
  class={cls}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
