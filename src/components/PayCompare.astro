---
// Side-by-side offer comparison. Plain arithmetic in the browser; nothing is sent anywhere.
import Icon from './Icon.astro';
const offers = [
  { key: 'a', name: 'Offer A', cpm: '0.60', miles: '2800', weeks: '48', benefits: '0' },
  { key: 'b', name: 'Offer B', cpm: '0.70', miles: '2200', weeks: '48', benefits: '0' },
];
const field = 'mt-1 w-full min-h-11 rounded border border-navy/20 bg-white px-3 text-navy focus:border-navy focus:outline-none';
---
<div class="mt-6 rounded-lg border border-navy/10 bg-white p-5 sm:p-8" data-pay-compare>
  <div class="flex items-start gap-4">
    <Icon name="dollar-week" class="h-12 w-12 shrink-0 text-navy" />
    <div>
      <h3 class="text-xl font-semibold text-navy">Compare two offers</h3>
      <p class="mt-1 text-sm text-slate">Put in what each recruiter told you. The math runs on your phone; nothing is sent anywhere.</p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {offers.map((o) => (
      <fieldset class="rounded-lg border border-navy/10 p-4" data-offer={o.key}>
        <legend class="px-1 font-semibold text-gold-ink">{o.name}</legend>
        <label class="block text-sm font-medium text-navy">Pay per mile ($)
          <input class={field} type="number" inputmode="decimal" min="0" step="0.01" name={`${o.key}-cpm`} value={o.cpm} data-k="cpm" />
        </label>
        <label class="mt-3 block text-sm font-medium text-navy">Weekly miles (fleet average)
          <input class={field} type="number" inputmode="numeric" min="0" step="50" name={`${o.key}-miles`} value={o.miles} data-k="miles" />
        </label>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <label class="block text-sm font-medium text-navy">Weeks worked a year
            <input class={field} type="number" inputmode="numeric" min="0" max="52" step="1" name={`${o.key}-weeks`} value={o.weeks} data-k="weeks" />
          </label>
          <label class="block text-sm font-medium text-navy">Benefits cost a month ($)
            <input class={field} type="number" inputmode="numeric" min="0" step="10" name={`${o.key}-benefits`} value={o.benefits} data-k="benefits" />
          </label>
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-3 rounded bg-cream p-3">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate">A week</dt>
            <dd class="text-lg font-bold text-navy" data-out="week">$1,680</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate">A year, less benefits</dt>
            <dd class="text-lg font-bold text-navy" data-out="year">$80,640</dd>
          </div>
        </dl>
      </fieldset>
    ))}
  </div>

  <p class="mt-6 rounded-lg bg-navy px-5 py-4 font-semibold text-cream" aria-live="polite" data-out="verdict">
    Offer A pays about $6,720 more a year, even though its rate is lower.
  </p>
  <p class="mt-3 text-xs text-slate">
    Estimates before taxes, per diem and deductions. Use the fleet's real weekly average, not the top driver's.
  </p>
</div>

<script>
  const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
  document.querySelectorAll<HTMLElement>('[data-pay-compare]').forEach((root) => {
    const read = (key: string) => {
      const box = root.querySelector<HTMLElement>(`[data-offer="${key}"]`)!;
      const v = (k: string) => Math.max(0, parseFloat((box.querySelector<HTMLInputElement>(`[data-k="${k}"]`)?.value || '0')) || 0);
      const week = v('cpm') * v('miles');
      const year = week * Math.min(52, v('weeks')) - v('benefits') * 12;
      const lower = v('cpm');
      return { box, week, year, rate: lower };
    };
    const update = () => {
      const a = read('a'), b = read('b');
      for (const o of [a, b]) {
        o.box.querySelector('[data-out="week"]')!.textContent = money(o.week);
        o.box.querySelector('[data-out="year"]')!.textContent = money(o.year);
      }
      const diff = a.year - b.year;
      const out = root.querySelector('[data-out="verdict"]')!;
      if (Math.abs(diff) < 1) { out.textContent = 'The two offers come out about the same over a year.'; return; }
      const [win, lose, wr, lr] = diff > 0 ? ['A', 'B', a.rate, b.rate] : ['B', 'A', b.rate, a.rate];
      const twist = wr < lr ? ', even though its rate is lower' : '';
      out.textContent = `Offer ${win} pays about ${money(Math.abs(diff))} more a year${twist}.`;
    };
    root.addEventListener('input', update);
    update();
  });
</script>
