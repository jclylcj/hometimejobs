---
const links = [
  { href: '/home-time/', label: 'Home Time' },
  { href: '/pay/', label: 'Pay' },
  { href: '/carriers/', label: 'Carriers' },
  { href: '/about/', label: 'About' },
];
---
<header class="bg-navy text-cream">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" aria-label="HomeTimeJobs home" class="flex min-h-11 items-center">
      <img src="/logo-header.svg" alt="HomeTimeJobs" class="h-9 w-auto" width="720" height="118" />
    </a>
    <div class="hidden items-center gap-6 text-sm md:flex">
      {links.map(l => (
        <a href={l.href} class="inline-flex min-h-11 items-center hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
    <a href="/#apply"
       class="inline-flex min-h-11 items-center rounded bg-gold px-4 text-sm font-semibold text-navy hover:bg-gold-light transition-colors">
      Get Matched
    </a>
  </nav>
</header>
