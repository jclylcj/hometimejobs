---
// Lead capture. Controlled by LEAD_FORM_ENABLED in src/config.ts.
// When disabled, the section renders a placeholder CTA and collects nothing ...
// no inputs, no submission endpoint, no personal information gathered.
//
// Uses Netlify Forms when enabled. On Vercel/Cloudflare, swap the action
// to a Formspree endpoint and drop the data-netlify attributes.
import { LEAD_FORM_ENABLED } from '../config';
---
<section id="apply" class="bg-navy-deep py-16 text-cream">
  <div class="mx-auto max-w-2xl px-5">
    <h2 class="text-3xl font-bold">Tell us when you need to be home.</h2>

    {LEAD_FORM_ENABLED ? (
      <>
        <p class="mt-3 text-slate-light">
          Three fields. No account, no résumé upload. We'll match you against carriers
          whose schedule actually fits your life ... and you'll hear from a real person.
        </p>

        <form
          name="driver-lead"
          method="POST"
          data-netlify="true"
          netlify-honeypot="company-website"
          action="/thank-you"
          class="mt-8 space-y-4"
        >
          <input type="hidden" name="form-name" value="driver-lead" />
          <p class="hidden">
            <label>Leave this blank: <input name="company-website" /></label>
          </p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium">Name</label>
              <input id="name" name="name" type="text" required
                class="mt-1 w-full rounded border border-white/20 bg-white/5 px-3 py-2
                       text-cream placeholder:text-slate-light focus:border-gold focus:outline-none"
                placeholder="First and last" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium">Phone</label>
              <input id="phone" name="phone" type="tel" required
                class="mt-1 w-full rounded border border-white/20 bg-white/5 px-3 py-2
                       text-cream placeholder:text-slate-light focus:border-gold focus:outline-none"
                placeholder="(555) 555-5555" />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium">Email</label>
            <input id="email" name="email" type="email" required
              class="mt-1 w-full rounded border border-white/20 bg-white/5 px-3 py-2
                     text-cream placeholder:text-slate-light focus:border-gold focus:outline-none"
              placeholder="you@example.com" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="hometime" class="block text-sm font-medium">Home time you want</label>
              <select id="hometime" name="hometime"
                class="mt-1 w-full rounded border border-white/20 bg-white/5 px-3 py-2
                       text-cream focus:border-gold focus:outline-none">
                <option value="">Select one</option>
                <option>Home daily</option>
                <option>Home weekends</option>
                <option>7 on / 7 off</option>
                <option>14 on / 7 off</option>
                <option>Long OTR - home every 3+ weeks</option>
                <option>Flexible</option>
              </select>
            </div>
            <div>
              <label for="experience" class="block text-sm font-medium">CDL-A experience</label>
              <select id="experience" name="experience"
                class="mt-1 w-full rounded border border-white/20 bg-white/5 px-3 py-2
                       text-cream focus:border-gold focus:outline-none">
                <option value="">Select one</option>
                <option>No CDL yet</option>
                <option>Recent grad</option>
                <option>Less than 1 year</option>
                <option>1–3 years</option>
                <option>3+ years</option>
              </select>
            </div>
          </div>

          <button type="submit"
            class="w-full rounded bg-gold px-6 py-3 font-semibold text-navy
                   hover:bg-gold-light transition-colors">
            Find My Match
          </button>

          <p class="text-xs text-slate-light">
            We share your information only with carriers you're matched to. No spam, no selling your data to anyone else.
          </p>
        </form>
      </>
    ) : (
      <div class="mt-6 rounded-lg border border-white/15 bg-white/5 p-6">
        <p class="text-slate-light">
          Driver matching opens soon. We're finishing carrier profiles first ... the
          comparison is only worth anything if it's accurate.
        </p>
        <p class="mt-3 text-slate-light">
          In the meantime, the guides below cover what actually decides a good fit:
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/home-time"
             class="rounded bg-gold px-5 py-2 text-sm font-semibold text-navy hover:bg-gold-light transition-colors">
            Home Time Explained
          </a>
          <a href="/pay"
             class="rounded border border-white/25 px-5 py-2 text-sm font-semibold hover:border-gold hover:text-gold transition-colors">
            How Driver Pay Works
          </a>
        </div>
      </div>
    )}
  </div>
</section>
