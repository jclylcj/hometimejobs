---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';

const schedules = [
  { name: 'Home Daily',    icon: 'schedule-home-daily',    detail: 'Local and dedicated runs. Home every night, usually within a set radius.' },
  { name: 'Home Weekends', icon: 'schedule-home-weekends', detail: 'Regional. Out during the week, back most weekends.' },
  { name: '7 on / 7 off',  icon: 'schedule-7-on-7-off',    detail: 'A full week out, a full week home. Predictable, and rare.' },
  { name: '14 on / 7 off', icon: 'schedule-14-on-7-off',   detail: 'Two weeks out, one week home. Common on longer OTR fleets.' },
  { name: 'Long OTR',      icon: 'schedule-long-otr',      detail: 'Three weeks or more between resets. Highest miles, most time away.' },
];

const checks = [
  { name: 'Home time, verified',   icon: 'check-home-time-verified', detail: 'Not the recruiting brochure — what drivers on that fleet actually experience.' },
  { name: 'Pay, translated',       icon: 'check-pay-translated',     detail: 'CPM, percentage, per diem, detention, and what the guaranteed minimum really covers.' },
  { name: 'Equipment and freight', icon: 'check-equipment-freight',  detail: 'Truck age, governed speed, APU, no-touch or not, rider and pet policy.' },
];
---
<Layout
  title="HomeTimeJobs — CDL Jobs Organized Around When You Get Home"
  description="Compare home time, pay, and equipment across trucking companies. Find CDL-A driving jobs that fit the life you actually want."
>
  <section class="relative overflow-hidden bg-navy text-cream">
    <img
      src="/media/hero-road-home.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="relative mx-auto max-w-4xl px-5 py-20 text-center">
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl">
        The question isn't what it pays.<br />
        <span class="text-gold">It's when you get home.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate">
        Every job board leads with cents per mile. Drivers leave over home time.
        We built this the other way around — schedule first, then pay, then everything else.
      </p>
      <a href="#apply"
         class="mt-8 inline-block rounded bg-gold px-8 py-3 font-semibold text-navy hover:bg-gold-light transition-colors">
        Get Matched
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="text-2xl font-bold">Start with the schedule</h2>
    <p class="mt-2 max-w-2xl text-slate">
      Carriers advertise home time in shorthand that doesn't always mean what it sounds like.
      Here's what each one looks like in practice.
    </p>

    <figure class="mt-8 overflow-x-auto rounded-lg border border-navy/10 bg-white p-4">
      <img src="/media/schedule-spectrum.svg" alt="" aria-hidden="true"
           class="h-auto w-full min-w-[720px]" width="1200" height="330" />
    </figure>
    <p class="mt-2 text-xs text-slate sm:hidden">Scroll to see the full spectrum &rarr;</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {schedules.map(s => (
        <div class="rounded-lg border border-navy/10 bg-white p-5">
          <img src={`/media/${s.icon}.svg`} alt="" aria-hidden="true" class="mb-4 h-12 w-12" width="48" height="48" />
          <p class="font-semibold text-navy">{s.name}</p>
          <p class="mt-2 text-sm text-slate">{s.detail}</p>
        </div>
      ))}
    </div>

    <a href="/home-time" class="mt-8 inline-block font-semibold text-teal hover:underline">
      Read the full breakdown &rarr;
    </a>
  </section>

  <section class="border-y border-navy/10 bg-white py-16">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold">What we actually check</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {checks.map(c => (
          <div>
            <img src={`/media/${c.icon}.svg`} alt="" aria-hidden="true" class="mb-4 h-14 w-14" width="56" height="56" />
            <p class="font-semibold text-gold">{c.name}</p>
            <p class="mt-2 text-sm text-slate">{c.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <LeadForm />
</Layout>
